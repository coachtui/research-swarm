// Prisma schema for Neon Postgres
// Database: Serverless PostgreSQL optimized for multi-tenant SaaS

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User accounts (synced from Clerk)
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  fullName  String?  @map("full_name")

  // Subscription tier
  tier             String  @default("free")  // free, pro, premium
  monthlyBudgetUsd Float   @default(200.0) @map("monthly_budget_usd")

  // Stripe subscription (new fields for paid plans)
  stripeCustomerId        String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId    String?   @map("stripe_subscription_id")
  stripeSubscriptionStatus String?  @map("stripe_subscription_status")  // active, canceled, past_due, trialing, incomplete
  stripePriceId           String?   @map("stripe_price_id")  // Which plan they're on
  subscriptionEndDate     DateTime? @map("subscription_end_date")  // When subscription period ends

  // Account status
  isActive  Boolean  @default(true) @map("is_active")
  isAdmin   Boolean  @default(false) @map("is_admin")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  runs            Run[]
  costLogs        CostLog[]
  watchlist       Watchlist[]
  usageQuotas     UsageQuota[]
  alertRules      AlertRule[]
  preferences     UserPreferences?

  @@index([email])
  @@index([clerkId])
  @@map("users")
}

// Analysis runs (batch or single stock)
model Run {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Run metadata
  runName         String?  @map("run_name")
  tickers         String[] // Array of tickers
  analysisPeriod  String?  @map("analysis_period")
  quarters        String[] // For TTM mode
  fiscalYear      Int?     @map("fiscal_year")
  newsDaysBack    Int      @default(30) @map("news_days_back")
  maxRetries      Int      @default(3) @map("max_retries")

  // Status tracking
  status          String   @default("queued")  // queued, running, completed, failed, cancelled
  totalStocks     Int      @default(0) @map("total_stocks")
  completedCount  Int      @default(0) @map("completed_count")
  failedCount     Int      @default(0) @map("failed_count")
  progressPercent Float    @default(0) @map("progress_percent")
  currentTicker   String?  @map("current_ticker")

  // Cost tracking
  totalCostUsd    Float    @default(0) @map("total_cost_usd")
  costSummary     Json?    @map("cost_summary")  // Detailed cost breakdown

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  elapsedSeconds  Float    @default(0) @map("elapsed_seconds")

  // Relations
  stockResults    StockResult[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("runs")
}

// Individual stock analysis results
model StockResult {
  id    String @id @default(uuid())
  runId String @map("run_id")
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  ticker String

  // Direct user reference (denormalized for query performance)
  userId  String? @map("user_id")

  // Status
  status      String @default("pending")  // pending, running, completed, failed
  retryCount  Int    @default(0) @map("retry_count")

  // Analysis results
  moatScore              Float?   @map("moat_score")
  financialHealthScore   Float?   @map("financial_health_score")
  businessModelMoatScore Float?   @map("business_model_moat_score")
  sentimentScore         Float?   @map("sentiment_score")
  technicalScore         Float?   @map("technical_score")
  supplyChainScore       Float?   @map("supply_chain_score")

  isWatchlistCandidate   Boolean? @map("is_watchlist_candidate")
  investmentThesis       String?  @map("investment_thesis") @db.Text

  // Full output (JSON blob from manager agent)
  fullOutput Json? @map("full_output")

  // Chart URLs (stored in R2)
  chartUrls  Json? @map("chart_urls")  // { moat: "url", supply_chain: "url" }

  // Metrics
  tokensUsed            Int?   @default(0) @map("tokens_used")
  costUsd               Float? @default(0) @map("cost_usd")
  processingTimeSeconds Float? @map("processing_time_seconds")

  // Error tracking
  errorMessage String? @map("error_message") @db.Text
  errorStack   String? @map("error_stack") @db.Text

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([runId, ticker])
  @@index([ticker])
  @@index([moatScore(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("stock_results")
}

// Cost tracking log (for budget monitoring)
model CostLog {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runId  String? @map("run_id")
  ticker String
  agent  String  // fundamentalist, news_hound, quant, manager

  tokensTotal Int   @map("tokens_total")
  tokensInput Int   @default(0) @map("tokens_input")
  tokensOutput Int  @default(0) @map("tokens_output")

  costUsd     Float @map("cost_usd")

  timestamp DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([runId])
  @@map("cost_logs")
}

// API keys for programmatic access (optional)
model ApiKey {
  id     String @id @default(uuid())
  userId String @map("user_id")

  keyHash  String   @unique @map("key_hash")  // SHA256 hash of the key
  name     String   // User-friendly name

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([keyHash])
  @@map("api_keys")
}

// Audit log for security and compliance
model AuditLog {
  id String @id @default(uuid())

  userId       String?  @map("user_id")
  action       String   // run_created, report_generated, etc.
  resourceType String   @map("resource_type")  // run, report, user
  resourceId   String   @map("resource_id")

  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text

  metadata   Json?    // Additional context

  timestamp DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// Report snapshots for CLI track record
model ReportSnapshot {
  id               String   @id @default(uuid())
  ticker           String
  runId            String   @map("run_id")
  analysisDate     String   @map("analysis_date")
  rating           String?
  priceAtAnalysis  Float    @map("price_at_analysis")
  priceTarget      Float    @map("price_target")
  moatScore        Float    @map("moat_score")
  snapshotData     Json     @map("snapshot_data")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([ticker, analysisDate])
  @@index([ticker])
  @@map("report_snapshots")
}

// Watchlist - user's tracked stocks
model Watchlist {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticker       String
  companyName  String? @map("company_name")

  // Tracking metadata
  addedAt        DateTime  @default(now()) @map("added_at")
  lastCheckedAt  DateTime? @map("last_checked_at")

  // Score tracking (for change detection)
  initialMoatScore      Float?    @map("initial_moat_score")
  initialAnalysisRunId  String?   @map("initial_analysis_run_id")
  latestMoatScore       Float?    @map("latest_moat_score")
  latestAnalysisRunId   String?   @map("latest_analysis_run_id")
  latestAnalysisDate    DateTime? @map("latest_analysis_date")
  scoreChange           Float?    @default(0) @map("score_change")

  // User customization
  notes         String?  @db.Text
  enableAlerts  Boolean  @default(true) @map("enable_alerts")

  @@unique([userId, ticker])
  @@index([userId, addedAt(sort: Desc)])
  @@index([ticker])
  @@map("watchlist")
}

// Usage quota tracking (for enforcing plan limits)
model UsageQuota {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Monthly period (calendar month UTC)
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")

  // Usage counters
  analysesUsed    Int @default(0) @map("analyses_used")
  watchlistCount  Int @default(0) @map("watchlist_count")

  // Limits (copied from tier at period start)
  analysesLimit   Int @map("analyses_limit")
  watchlistLimit  Int @map("watchlist_limit")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("usage_quotas")
}

// Alert rules - user-defined alert conditions
model AlertRule {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticker     String
  alertType  String  @map("alert_type")  // score_change, rating_change, divergence_detected

  // Threshold (e.g., score change > 1.0 points)
  threshold  Float?

  isActive  Boolean @default(true) @map("is_active")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@index([ticker, isActive])
  @@map("alert_rules")
}

// Alert history - track what alerts were sent
model AlertHistory {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")

  ticker     String
  alertType  String  @map("alert_type")
  message    String  @db.Text

  // Reference to the run that triggered the alert
  runId  String? @map("run_id")

  // Email delivery status
  emailSent   Boolean @default(false) @map("email_sent")
  emailError  String? @map("email_error") @db.Text

  triggeredAt  DateTime @default(now()) @map("triggered_at")

  @@index([userId, triggeredAt(sort: Desc)])
  @@index([ticker])
  @@map("alert_history")
}

// User preferences - dashboard settings
model UserPreferences {
  id      String   @id @default(uuid())
  userId  String   @unique @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dashboard settings
  defaultView         String  @default("watchlist") @map("default_view")
  hideOnboardingTips  Boolean @default(false) @map("hide_onboarding_tips")

  // Alert preferences
  emailAlerts   Boolean @default(true) @map("email_alerts")
  weeklyDigest  Boolean @default(true) @map("weekly_digest")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}
