// Prisma schema for Neon Postgres
// Database: Serverless PostgreSQL optimized for multi-tenant SaaS

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User accounts (synced from Clerk)
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  fullName  String?  @map("full_name")

  // Subscription tier
  tier             String  @default("free")  // free, starter, investor, trader
  monthlyBudgetUsd Float   @default(200.0) @map("monthly_budget_usd")

  // Stripe subscription (new fields for paid plans)
  stripeCustomerId        String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId    String?   @map("stripe_subscription_id")
  stripeSubscriptionStatus String?  @map("stripe_subscription_status")  // active, canceled, past_due, trialing, incomplete
  stripePriceId           String?   @map("stripe_price_id")  // Which plan they're on
  subscriptionEndDate     DateTime? @map("subscription_end_date")  // When subscription period ends
  cancelAtPeriodEnd       Boolean   @default(false) @map("cancel_at_period_end")
  graceUntil              DateTime? @map("grace_until")  // Past-due grace window expiry

  // 30-day rolling billing period (set by Stripe webhooks)
  billingPeriodStart  DateTime? @map("billing_period_start")
  billingPeriodEnd    DateTime? @map("billing_period_end")

  // Account status
  isActive  Boolean  @default(true) @map("is_active")
  isAdmin   Boolean  @default(false) @map("is_admin")

  // Email verification status (synced from Clerk webhooks)
  emailVerified Boolean @default(false) @map("email_verified")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  runs             Run[]
  costLogs         CostLog[]
  watchlist        Watchlist[]
  usageQuotas      UsageQuota[]
  usageCounters    UsageCounter[]
  alertRules       AlertRule[]
  preferences      UserPreferences?
  entitlement      Entitlement?
  freeReportCredit FreeReportCredit?
  portfolios       Portfolio[]

  @@index([email])
  @@index([clerkId])
  @@map("users")
}

// Analysis runs (batch or single stock)
model Run {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Run metadata
  runName         String?  @map("run_name")
  tickers         String[] // Array of tickers
  analysisPeriod  String?  @map("analysis_period")
  quarters        String[] // For TTM mode
  fiscalYear      Int?     @map("fiscal_year")
  newsDaysBack    Int      @default(30) @map("news_days_back")
  maxRetries      Int      @default(3) @map("max_retries")

  // Status tracking
  status          String   @default("queued")  // queued, running, completed, failed, cancelled
  totalStocks     Int      @default(0) @map("total_stocks")
  completedCount  Int      @default(0) @map("completed_count")
  failedCount     Int      @default(0) @map("failed_count")
  progressPercent Float    @default(0) @map("progress_percent")
  currentTicker   String?  @map("current_ticker")

  // Cost tracking
  totalCostUsd    Float    @default(0) @map("total_cost_usd")
  costSummary     Json?    @map("cost_summary")  // Detailed cost breakdown

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  elapsedSeconds  Float    @default(0) @map("elapsed_seconds")

  // Relations
  stockResults    StockResult[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("runs")
}

// Individual stock analysis results
model StockResult {
  id    String @id @default(uuid())
  runId String @map("run_id")
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  ticker String

  // Direct user reference (denormalized for query performance)
  userId  String? @map("user_id")

  // Status
  status      String @default("pending")  // pending, running, completed, failed
  retryCount  Int    @default(0) @map("retry_count")

  // Analysis results
  moatScore              Float?   @map("moat_score")
  financialHealthScore   Float?   @map("financial_health_score")
  businessModelMoatScore Float?   @map("business_model_moat_score")
  sentimentScore         Float?   @map("sentiment_score")
  technicalScore         Float?   @map("technical_score")
  supplyChainScore       Float?   @map("supply_chain_score")

  isWatchlistCandidate   Boolean? @map("is_watchlist_candidate")
  investmentThesis       String?  @map("investment_thesis") @db.Text

  // Full output (JSON blob from manager agent)
  fullOutput Json? @map("full_output")

  // Chart URLs (stored in R2)
  chartUrls  Json? @map("chart_urls")  // { moat: "url", supply_chain: "url" }

  // Sector/industry classification (snapshot at report generation time, sourced from TickerMeta)
  sector        String?   @map("sector")
  industry      String?   @map("industry")
  subIndustry   String?   @map("sub_industry")
  exchange      String?   @map("exchange")
  country       String?   @map("country")
  currency      String?   @map("currency")
  metaSource    String?   @map("meta_source")    // e.g. "yfinance"
  metaUpdatedAt DateTime? @map("meta_updated_at")

  // Metrics
  tokensUsed            Int?   @default(0) @map("tokens_used")
  costUsd               Float? @default(0) @map("cost_usd")
  processingTimeSeconds Float? @map("processing_time_seconds")

  // Public example flag — admin-approved reports shown on the landing page.
  // At most one result per ticker should have this set to true.
  isPublicExample Boolean @default(false) @map("is_public_example")

  // Error tracking
  errorMessage String? @map("error_message") @db.Text
  errorStack   String? @map("error_stack") @db.Text

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([runId, ticker])
  @@index([ticker])
  @@index([moatScore(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sector])
  @@map("stock_results")
}

// Cost tracking log (for budget monitoring)
model CostLog {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runId  String? @map("run_id")
  ticker String
  agent  String  // fundamentalist, news_hound, quant, manager

  tokensTotal Int   @map("tokens_total")
  tokensInput Int   @default(0) @map("tokens_input")
  tokensOutput Int  @default(0) @map("tokens_output")

  costUsd     Float @map("cost_usd")

  timestamp DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([runId])
  @@map("cost_logs")
}

// API keys for programmatic access (optional)
model ApiKey {
  id     String @id @default(uuid())
  userId String @map("user_id")

  keyHash  String   @unique @map("key_hash")  // SHA256 hash of the key
  name     String   // User-friendly name

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([keyHash])
  @@map("api_keys")
}

// Audit log for security and compliance
model AuditLog {
  id String @id @default(uuid())

  userId       String?  @map("user_id")
  action       String   // run_created, report_generated, etc.
  resourceType String   @map("resource_type")  // run, report, user
  resourceId   String   @map("resource_id")

  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text

  metadata   Json?    // Additional context

  timestamp DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// Report snapshots for CLI track record
model ReportSnapshot {
  id               String   @id @default(uuid())
  ticker           String
  runId            String   @map("run_id")
  analysisDate     String   @map("analysis_date")
  rating           String?
  priceAtAnalysis  Float    @map("price_at_analysis")
  priceTarget      Float    @map("price_target")
  moatScore        Float    @map("moat_score")
  snapshotData     Json     @map("snapshot_data")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([ticker, analysisDate])
  @@index([ticker])
  @@map("report_snapshots")
}

// Watchlist - user's tracked stocks
model Watchlist {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticker       String
  companyName  String? @map("company_name")

  // Tracking metadata
  addedAt        DateTime  @default(now()) @map("added_at")
  lastCheckedAt  DateTime? @map("last_checked_at")

  // Score tracking (for change detection)
  initialMoatScore      Float?    @map("initial_moat_score")
  initialAnalysisRunId  String?   @map("initial_analysis_run_id")
  latestMoatScore       Float?    @map("latest_moat_score")
  latestAnalysisRunId   String?   @map("latest_analysis_run_id")
  latestAnalysisDate    DateTime? @map("latest_analysis_date")
  scoreChange           Float?    @default(0) @map("score_change")

  // User customization
  notes         String?  @db.Text
  enableAlerts  Boolean  @default(true) @map("enable_alerts")

  @@unique([userId, ticker])
  @@index([userId, addedAt(sort: Desc)])
  @@index([ticker])
  @@map("watchlist")
}

// Usage quota tracking (for enforcing plan limits)
model UsageQuota {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Monthly period (calendar month UTC)
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")

  // Usage counters
  analysesUsed       Int @default(0) @map("analyses_used")
  boostAnalysesAdded Int @default(0) @map("boost_analyses_added")
  watchlistCount     Int @default(0) @map("watchlist_count")

  // Limits (copied from tier at period start)
  analysesLimit   Int @map("analyses_limit")
  watchlistLimit  Int @map("watchlist_limit")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("usage_quotas")
}

// Alert rules - user-defined alert conditions
model AlertRule {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticker     String
  alertType  String  @map("alert_type")  // score_change, rating_change, divergence_detected

  // Threshold (e.g., score change > 1.0 points)
  threshold  Float?

  isActive  Boolean @default(true) @map("is_active")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@index([ticker, isActive])
  @@map("alert_rules")
}

// Alert history - track what alerts were sent
model AlertHistory {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")

  ticker     String
  alertType  String  @map("alert_type")
  message    String  @db.Text

  // Reference to the run that triggered the alert
  runId  String? @map("run_id")

  // Email delivery status
  emailSent   Boolean @default(false) @map("email_sent")
  emailError  String? @map("email_error") @db.Text

  triggeredAt  DateTime @default(now()) @map("triggered_at")

  @@index([userId, triggeredAt(sort: Desc)])
  @@index([ticker])
  @@map("alert_history")
}

// Computed entitlements — billing-authoritative feature flags and limits.
// Written by Stripe webhooks and /billing/refresh. Read on every request.
model Entitlement {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Effective tier at the time entitlements were computed
  tier    String

  // Feature flags and numeric limits (JSON objects)
  flags   Json  // { "report.full.read": true, "allocation.sizing.write": false, ... }
  limits  Json  // { "limits.runs.daily": 50, "limits.history.days": 90 }

  // Config version for cache invalidation on schema changes
  version String @default("entitlements.v1")

  // Effective window
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("entitlements")
}

// Fine-grained usage counters keyed by (user, metric, UTC-day).
// Used for daily run limits (limits.runs.daily).
model UsageCounter {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String   // e.g. "limits.runs.daily"
  periodStart DateTime @map("period_start")  // UTC midnight of the day
  count       Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key, periodStart])
  @@index([userId, key, periodStart])
  @@map("usage_counters")
}

// User preferences - dashboard settings
model UserPreferences {
  id      String   @id @default(uuid())
  userId  String   @unique @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dashboard settings
  defaultView         String  @default("watchlist") @map("default_view")
  hideOnboardingTips  Boolean @default(false) @map("hide_onboarding_tips")

  // Alert preferences
  emailAlerts   Boolean @default(true) @map("email_alerts")
  weeklyDigest  Boolean @default(true) @map("weekly_digest")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

// Free tier lifetime report credit tracking
// Free users get 2 total reports (not monthly — lifetime).
model FreeReportCredit {
  id      String @id @default(uuid())
  userId  String @unique @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  creditsTotal Int @default(2) @map("credits_total")
  creditsUsed  Int @default(0) @map("credits_used")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("free_report_credits")
}

// Device-level free usage tracking for anti-abuse.
// Keyed on device_id (UUID generated by frontend, stored in localStorage + cookie).
model DeviceFreeUsage {
  deviceId         String @id @map("device_id")
  totalFreeReports Int    @default(0) @map("total_free_reports")

  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("device_free_usage")
}

// Per-user, per-ticker deployment metrics cache.
// Extracted from existing StockResult.fullOutput — NO new LLM calls.
// Snapshots are bucketed by 24h UTC window. Cache is invalidated when
// model_version or ruleset_version changes, forcing a fresh computation.
model DeploymentMetricsCache {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Snapshot identity (same values for all tickers in the same snapshot)
  snapshotId      String   @map("snapshot_id")   // UUID shared by all rows in a snapshot
  snapshotBucket  DateTime @map("snapshot_bucket") // UTC midnight of the snapshot day
  universeHash    String   @map("universe_hash")  // SHA-256[:16] of sorted ticker set
  modelVersion    String   @default("1.1.0") @map("model_version")
  rulesetVersion  String   @default("1.0.0") @map("ruleset_version")

  // Snapshot-level aggregates (denormalized for fast response building)
  universeSize   Int    @default(0)    @map("universe_size")
  eligibleCount  Int    @default(0)    @map("eligible_count")
  capitalPosture String @default("Low") @map("capital_posture")
  exposureCeiling Float  @default(50)  @map("exposure_ceiling")

  // Snapshot timestamps
  generatedAt  DateTime @default(now()) @map("generated_at")
  ttlExpiresAt DateTime @map("ttl_expires_at")

  // Per-ticker metrics
  ticker             String
  sector             String  @default("Unknown")
  allocationCurrent  Float   @default(0)  @map("allocation_current")
  allocationDelta30d Float?  @map("allocation_delta_30d")  // null = no prior run
  confirmationScore  Int     @default(0)  @map("confirmation_score")  // 0-5
  evRatio            Float?  @map("ev_ratio")               // probability_weighted_ev / current_price
  volAdjEvScore      Float?  @map("vol_adj_ev_score")       // evRatio * (1 - stop_prob/100)
  stopProbability    Float   @default(50) @map("stop_probability")
  regimeStable       Boolean @default(true) @map("regime_stable")
  sourceRunId        String  @map("source_run_id")

  @@unique([userId, snapshotBucket, ticker])
  @@index([userId, universeHash, modelVersion, snapshotBucket])
  @@index([userId, generatedAt])
  @@map("deployment_metrics_cache")
}

// Per-sector aggregate snapshot persisted each time the deployment panel is served.
// Enables Δ Opp / Δ Structural / Δ Tier2 trend comparison between snapshots.
model SectorSnapshotHistory {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  snapshotId     String   @map("snapshot_id")
  snapshotBucket DateTime @map("snapshot_bucket")
  sector         String

  totalTracked      Int     @map("total_tracked")
  confirmedCount    Int     @map("confirmed_count")
  confirmedPct      Float   @map("confirmed_pct")
  structuralScore   Float   @map("structural_score")
  oppScore          Float   @map("opp_score")
  rotationScore     Float   @map("rotation_score")
  tier2Count        Int     @map("tier2_count")
  avgRiskAdjEdge    Float   @map("avg_risk_adj_edge_pct")
  positiveEdgeRatio Float   @map("positive_edge_ratio")
  medianStopPct     Float   @map("median_stop_pct")
  coveragePct       Float   @map("coverage_pct")
  universeSize      Int     @map("universe_size")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, snapshotBucket, sector])
  @@index([userId, snapshotBucket])
  @@map("sector_snapshot_history")
}

// Ticker sector/industry metadata cache.
// Sourced from yfinance on first report generation; refreshed if > 30 days old.
// Indexed by uppercase ticker. Reports snapshot sector at generation time.
model TickerMeta {
  ticker      String   @id                  // Uppercase ticker symbol (e.g. "AAPL")
  sector      String?                       // e.g. "Technology"
  industry    String?                       // e.g. "Semiconductors"
  subIndustry String?  @map("sub_industry") // Optional finer classification
  exchange    String?                       // e.g. "NMS"
  country     String?                       // e.g. "United States"
  currency    String?                       // e.g. "USD"
  source      String   @default("yfinance") // Data provider
  raw         Json?                         // Small subset of raw provider response
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([updatedAt])
  @@map("ticker_meta")
}

// ── Portfolio Engine Models ─────────────────────────────────────────────────
// Compounder Ownership OS v3.1 — portfolio-first capital ownership system.
// Engine produces canonical actions; users mark them executed/ignored.

// User-defined portfolio. Starter/Investor: 1 max. Trader: up to 5.
model Portfolio {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   @default("Core")
  mandate   String   @default("compounder")  // "compounder" | "growth" | "custom"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cashBalance      Float     @default(0)    @map("cash_balance")
  cashUpdatedAt    DateTime? @map("cash_updated_at")

  positions Position[]
  actions   PortfolioAction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("portfolios")
}

// Position state machine — tracks ownership lifecycle for each holding.
model Position {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  ticker        String
  currentWeight Float    @default(0)  @map("current_weight")   // 0.0 – 1.0 fraction
  costBasis     Float?   @map("cost_basis")                     // Average cost per share
  shares        Float?                                          // Number of shares (optional)

  // State machine fields
  tierState        String @default("none") @map("tier_state")           // "none" | "t1_20" | "t2_30" | "t3_40" | "t4_50"
  thesisState      String @default("intact") @map("thesis_state")      // "intact" | "monitoring" | "broken"
  eligibilityState String @default("pending") @map("eligibility_state") // "pending" | "eligible" | "disqualified"
  ownershipStatus  String @default("watch") @map("ownership_status")   // "core_compounder" | "watch" | "disqualified"

  // Tracking
  entryDate       DateTime? @map("entry_date")
  quartersHeld    Int       @default(0) @map("quarters_held")
  compounderScore Float?    @map("compounder_score")
  lastDrawdown    Float?    @map("last_drawdown")

  // Drawdown add-cycle tracking (JSON array of applied thresholds)
  addTiersApplied Json @default("[]") @map("add_tiers_applied")

  // Link to most recent research
  latestRunId String? @map("latest_run_id")

  lastKnownPrice         Float?    @map("last_known_price")
  lastPriceAt            DateTime? @map("last_price_at")
  targetWeight           Float     @default(0) @map("target_weight")
  engineSuggestedWeight  Float?    @map("engine_suggested_weight")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([portfolioId, ticker])
  @@index([portfolioId])
  @@index([ticker])
  @@map("positions")
}

// Immutable action log — engine produces these, user executes/ignores.
model PortfolioAction {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  ticker      String
  actionType  String   @map("action_type")   // INITIATE | ADD_TIER_20..50 | TRIM_EUPHORIA | TRIM_CAP | EXIT_THESIS | REPLACE | HOLD
  weightDelta Float    @map("weight_delta")   // Signed: +0.02 for add, -0.03 for trim
  reasonCodes String[] @map("reason_codes")   // e.g. ["drawdown_30pct", "thesis_intact", "durable"]
  reasonText  String?  @map("reason_text") @db.Text

  // Status lifecycle
  status String @default("pending") // "pending" | "executed" | "ignored" | "expired"

  // Snapshot of signal state at action generation time
  signalSnapshot Json? @map("signal_snapshot")

  // Trigger metadata
  triggerCycle  String? @map("trigger_cycle")   // "monthly_2026_03" | "quarterly_2026_Q1" | "annual_2026"
  engineVersion String? @map("engine_version")

  createdAt  DateTime  @default(now()) @map("created_at")
  executedAt DateTime? @map("executed_at")
  expiresAt  DateTime? @map("expires_at")

  triggerPrice      Float?             @map("trigger_price")
  triggerCondition  String?            @map("trigger_condition")   // "price_above" | "price_below" | "catalyst_confirmed" | "immediate"
  parentActionId    String?            @map("parent_action_id")
  parent            PortfolioAction?   @relation("ActionChain", fields: [parentActionId], references: [id])
  children          PortfolioAction[]  @relation("ActionChain")

  @@index([portfolioId, createdAt(sort: Desc)])
  @@index([portfolioId, status])
  @@index([ticker])
  @@map("portfolio_actions")
}

// ── Ticker Financials Cache ────────────────────────────────────────────────
// Quarterly and annual financial data cached per ticker.
// Avoids re-fetching the same earnings data on every analysis run.
// On each analysis: check this table first; only call yfinance/EDGAR if missing or stale.
model TickerFinancials {
  id     String @id @default(cuid())
  ticker String

  // Period identifier — "2024-Q4" | "2024-FY" | "2023-Q3" etc.
  period    String
  periodEnd DateTime @map("period_end")

  // Data source (prefer edgar > yfinance for completeness)
  source String  // "yfinance" | "edgar"

  // Income statement
  revenue         Float?
  operatingIncome Float?  @map("operating_income")
  operatingMargin Float?  @map("operating_margin")   // operating_income / revenue
  grossProfit     Float?  @map("gross_profit")
  netIncome       Float?  @map("net_income")
  ebitda          Float?

  // Cash flow statement
  operatingCashFlow Float? @map("operating_cash_flow")
  capex             Float?
  freeCashFlow      Float? @map("free_cash_flow")  // operating_cf - capex

  // Balance sheet snapshots
  totalDebt Float? @map("total_debt")
  cash      Float?

  // Fetch metadata
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([ticker, period, source])
  @@index([ticker, periodEnd(sort: Desc)])
  @@map("ticker_financials")
}

// ── Data Cache Models ──────────────────────────────────────────────────────────
// Neon PostgreSQL-backed TTL cache for all external data fetches.
// Written/read by DataCacheService (psycopg2, sync) in data_provider_hybrid.py.
//
// Tier 1 (90d)  : company_profile, financial_statements  — slow-changing fundamentals
// Tier 2 (7d)   : earnings_calendar, analyst_data        — semi-dynamic signals
// Tier 2B (24h) : short_interest                         — daily FINRA/dark-pool refresh
// Tier 2C (48h) : institutional_ownership, insider_transactions — 13F-frequency
// Tier 3 (15min): price_snapshot                         — real-time valuation + OHLCV

