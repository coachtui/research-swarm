# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Financial Data
FMP_API_KEY=your-fmp-api-key-here # financialmodelingprep.com (free tier)

# News Data
NEWS_API_KEY=your-newsapi-key-here  # newsapi.org ($50/month)

# Email Notifications (Phase 9)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# App Settings
LOG_LEVEL=INFO
CACHE_DIR=./data/cache
STATE_DIR=./data/state

# ============================================
# API-SPECIFIC SETTINGS (Phase 1+)
# ============================================

# API Environment
ENVIRONMENT=development  # development, staging, production
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/research_swarm?sslmode=require

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Background Jobs (Inngest)
INNGEST_SIGNING_KEY=signkey-prod-your_signing_key
INNGEST_EVENT_KEY=your_event_key

# Cloud Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=research-swarm-reports
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email (Resend - alternative to SMTP)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_FROM_EMAIL=noreply@research-swarm.com

# Monitoring (Sentry)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_URL=https://your_redis.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# Local Development Mocks
USE_MOCK_AUTH=true
USE_MOCK_INNGEST=true
USE_LOCAL_STORAGE=true
