{% set signals = [
    ("News Sentiment",       stock.signal_breakdown.news_score,          stock.signal_breakdown.news_interpretation),
    ("Earnings Revisions",   stock.signal_breakdown.earnings_score,       stock.signal_breakdown.earnings_interpretation),
