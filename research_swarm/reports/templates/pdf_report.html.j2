<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DVRG — Equity Research — {% if stocks|length == 1 %}{{ stocks[0].ticker }}{% else %}{{ report.run_name or report.run_id }}{% endif %}</title>
</head>
<body>

<div class="running-logo">{% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="DVRG">{% else %}DVRG{% endif %}</div>

{# ═══════════════════════════════════════════════════════════════════════════
   TITLE PAGE
   ═══════════════════════════════════════════════════════════════════════════ #}
{% if stocks|length > 1 %}
<div class="cover-header" style="padding-top: 0.5in; margin-bottom: 0.3in;">
    <p class="brand">DVRG</p>
    <p class="subtitle">AI Stock Analysis Report</p>
</div>

<div class="cover-meta">
    <div>
        <div style="font-size: 16pt; font-weight: 700; color: #1a1a2e;">
            {{ report.run_name or ("Run " ~ report.run_id[:8]) }}
        </div>
        <div style="font-size: 7.5pt; color: #718096; margin-top: 4pt;">
            Run ID: {{ report.run_id }}
        </div>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 8pt; color: #718096;">
            Generated {{ report.generated_at.strftime('%B %d, %Y') }}
        </div>
        <div style="font-size: 8pt; color: #718096; margin-top: 2pt;">
            Analysis Period: {{ report.analysis_period }}
        </div>
    </div>
</div>

<div class="metrics-row" style="margin: 0.35in 0;">
    <div class="metric-item">
        <p class="metric-label">Stocks Analyzed</p>
        <p class="metric-value">{{ report.completed_count }}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Average Score</p>
        <p class="metric-value">{{ "%.1f"|format(report.average_moat_score) }}/10</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Top Picks</p>
        <p class="metric-value">{{ report.top_picks|length }}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Watchlist</p>
        <p class="metric-value">{{ report.watchlist_candidates|length }}</p>
    </div>
    {% if report.failed_count > 0 %}
    <div class="metric-item">
        <p class="metric-label">Failed</p>
        <p class="metric-value" style="color: #EF4444;">{{ report.failed_count }}</p>
    </div>
    {% endif %}
</div>

{# Table of Contents #}
<h2 class="section-header">Table of Contents</h2>
<table class="data-table">
    <thead>
        <tr>
            <th>Ticker</th>
            <th>Rating</th>
            <th style="text-align: right;">Score</th>
            <th>Risk</th>
            <th>Cohort</th>
        </tr>
    </thead>
    <tbody>
        {% set top_tickers = report.top_picks | map(attribute='ticker') | list %}
        {% set watchlist_tickers = report.watchlist_candidates | map(attribute='ticker') | list %}
{% for stock in stocks %}
        <tr>
            <td class="strong">{{ stock.ticker }}</td>
            <td>
                {% if stock.rating %}
                <span class="badge badge-{{ stock.rating|lower|replace(' ', '-') }}">{{ stock.rating }}</span>
                {% else %}—{% endif %}
            </td>
            <td class="num">{{ "%.1f"|format(stock.moat_score) }}/10</td>
            <td>{{ stock.risk_level or "—" }}</td>
            <td>
                {% if stock.ticker in top_tickers %}Top Pick
                {% elif stock.ticker in watchlist_tickers %}Watchlist
                {% else %}Reviewed{% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div class="disclaimer" style="margin-top: 0.4in;">
    This report contains AI-generated probabilistic estimates and does not constitute
    investment advice or a solicitation to buy or sell any security. All price targets and
    scenarios are forward-looking and subject to material change. Past performance is not
    indicative of future results. Consult a qualified financial advisor before acting on
    any information in this report. © DVRG — AI-Powered Institutional-Grade Stock Analysis.
</div>

{% endif %}

{# ═══════════════════════════════════════════════════════════════════════════
   PER-STOCK PAGES
   ═══════════════════════════════════════════════════════════════════════════ #}
{% for stock in stocks %}
<div class="page-break"></div>

{# ── PAGE 1 of each stock: THE CALL ───────────────────────────────────────── #}

<table class="masthead" style="width: 100%; border-collapse: collapse;"><tr>
    <td class="brand-cell" data-ticker="{{ stock.ticker }}">
        {% if logo_data_uri %}<img class="brand-logo" src="{{ logo_data_uri }}" alt="DVRG">
        {% else %}<p class="brand-word">DVRG</p>{% endif %}
        <p class="brand-sub">Equity Research</p>
    </td>
    <td><p class="gen"><b>Research Note</b>Generated {{ report.analysis_date }}<br>Model: DVRG Quality &times; Valuation v4</p></td>
</tr></table>

<table class="companyrow"><tr>
    <td><h2>{{ stock.company_name or stock.ticker }}</h2></td>
    <td class="tick"><b>{{ stock.ticker }}</b>
        {%- if stock.peer_comparison and stock.peer_comparison.sector %}{{ stock.peer_comparison.sector }}{% endif %}</td>
    <td class="chip-cell"><span class="chip">{{ stock.rating or "N/R" }}
        {%- if stock.risk_level %}<small>{{ stock.risk_level|upper }} RISK</small>{% endif %}</span></td>
</tr></table>

<table class="cols"><tr>
<td class="main-col">

    {# ── DVRG RATING — the 3×3 matrix with the active cell ── #}
    <div class="bar"><b>DVRG Rating</b><span>Two-axis model &middot; Data as of {{ report.analysis_date }}</span></div>
    {% if stock.valuation_axis is not none and stock.quality_tier and stock.valuation_tier %}
    <table class="matrixwrap"><tr>
        <td style="width: 190pt;">
            <table class="matrix">
                <tr><th></th><th>Attractive</th><th>Fair</th><th>Expensive</th></tr>
                {% for q_key, q_label, cells in [
                    ("high", "High quality", ["Strong Buy", "Buy", "Hold"]),
                    ("mid",  "Mid quality",  ["Buy", "Hold", "Hold"]),
                    ("low",  "Low quality",  ["Hold", "Sell", "Strong Sell"]),
                ] %}
                <tr><th>{{ q_label }}</th>
                    {% for v_key in ["attractive", "fair", "expensive"] %}
                    {% set active = stock.quality_tier == q_key and stock.valuation_tier == v_key %}
                    <td{% if active %} class="on"{% endif %}>{{ cells[loop.index0] }}{% if active %} &#9679;{% endif %}</td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </table>
        </td>
        <td class="axisnote">
            <div class="big">Quality {{ "%.1f"|format(stock.moat_score) }}/10 &middot; Valuation {{ "%.1f"|format(stock.valuation_axis) }}/10</div>
            The business ranks in the market's {{ stock.quality_tier }} quality tier; the price screens
            as {{ stock.valuation_tier }}. The rating is the intersection of both axes &mdash; a rich price
            alone never produces a Sell, and a cheap price never lifts a weak business past Hold.
            {% if stock.moat_breakdown and stock.moat_breakdown.technical_strength %}
            <div class="delta">Technical {{ "%.1f"|format(stock.moat_breakdown.technical_strength) }}/10 &mdash; gate only, does not enter the axes</div>
            {% endif %}
        </td>
    </tr></table>
    {% else %}
    <p style="font-size: 7pt; margin: 2pt 0;">Composite quality score
        <strong>{{ "%.1f"|format(stock.moat_score) }}/10</strong>
        {%- if stock.rating %} &rarr; <strong>{{ stock.rating }}</strong>{% endif %}.
        Two-axis detail unavailable for this run.</p>
    {% endif %}

    {# ── VERDICT ── #}
    {% if stock.decision_framework %}
    {% if stock.conviction_statement %}{% set verdict_detail = stock.conviction_statement.bottom_line %}
    {% elif stock.investment_thesis and stock.investment_thesis is not string %}{% set verdict_detail = stock.investment_thesis.recommendation_summary %}
    {% else %}{% set verdict_detail = "" %}{% endif %}
    {# the detail often re-states the rating the one-liner already leads with — strip it #}
    {% if stock.rating and verdict_detail.upper().startswith(stock.rating.upper()) %}
    {% set verdict_detail = verdict_detail[stock.rating|length:].lstrip(" —–-:") %}
    {% set verdict_detail = verdict_detail[0]|upper + verdict_detail[1:] if verdict_detail else "" %}
    {% endif %}
    <div class="verdict"><b>{{ stock.decision_framework.one_liner|clip(110) }}</b>
        {{ verdict_detail|clip(250) }}
    </div>
    {% elif stock.investment_thesis %}
    <div class="verdict">
        {% if stock.investment_thesis is string %}<b>{{ stock.investment_thesis|clip(260) }}</b>
        {% else %}<b>{{ stock.investment_thesis.recommendation_summary|clip(260) }}</b>{% endif %}
    </div>
    {% endif %}

    {# ── THE DIVERGENCE MAP — the chart the rating is derived from ── #}
    {% if stock.charts and stock.charts.divergence_map %}
    <div class="chartsec">
    <div class="bar"><b>The Divergence Map</b><span>Price &middot; intrinsic band &middot; street consensus &middot; DVRG targets</span></div>
    <div class="chart">{{ stock.charts.divergence_map|safe }}</div>
    <p class="chart-caption">Where the market has taken the price, where the business's intrinsic band sits,
    what the street expects, and how DVRG weights the two into its 12-month targets. When these lines
    converge there is no trade; the divergence is the thesis.</p>
    </div>
    {% endif %}

    {# ── FALSIFIER STRIP — the headline trigger in each direction ── #}
    {% if stock.upgrade_triggers or stock.downgrade_triggers %}
    <div class="chartsec">
    <div class="bar"><b>What Would Change Our Mind</b><span>Model triggers &middot; full table inside</span></div>
    <table class="falsifier"><tr>
        {% if stock.upgrade_triggers %}
        <td><span class="trig-up">&#9650; UPGRADE</span><br>
            {{ stock.upgrade_triggers[0].metric }}: {{ stock.upgrade_triggers[0].threshold|clip(110) }}</td>
        {% endif %}
        {% if stock.downgrade_triggers %}
        <td><span class="trig-down">&#9660; DOWNGRADE</span><br>
            {{ stock.downgrade_triggers[0].metric }}: {{ stock.downgrade_triggers[0].threshold|clip(110) }}</td>
        {% endif %}
    </tr></table>
    </div>
    {% endif %}

    {% if stock.charts and stock.charts.price_volume %}
    <div class="chartsec">
    <div class="bar"><b>Price &amp; Volume</b><span>Yahoo Finance &middot; 12 months daily</span></div>
    <div class="chart">{{ stock.charts.price_volume|safe }}</div>
    </div>
    {% endif %}

    {% if stock.charts and (stock.charts.quarterly_revenue or stock.charts.quarterly_net_income) %}
    <div class="chartsec">
    <div class="bar"><b>Quarterly Performance</b><span>Company filings, as reported</span></div>
    <table class="duo"><tr>
        {% if stock.charts.quarterly_revenue %}
        <td><p class="duo-cap">Revenue, $B</p><div class="chart">{{ stock.charts.quarterly_revenue|safe }}</div></td>
        {% endif %}
        {% if stock.charts.quarterly_net_income %}
        <td><p class="duo-cap">Net income, $M</p><div class="chart">{{ stock.charts.quarterly_net_income|safe }}</div></td>
        {% endif %}
    </tr></table>
    </div>
    {% endif %}

</td>
<td class="rail-col">

    {% if stock.investment_thesis and stock.investment_thesis is not string and stock.investment_thesis.company_overview %}
    <div class="bar"><b>Business Summary</b><span>Filings</span></div>
    <p>{{ stock.investment_thesis.company_overview|clip(300) }}</p>
    {% endif %}

    <div class="bar"><b>Overview</b><span>As of {{ report.analysis_date }}</span></div>
    <table class="kv">
        {% if stock.valuation_metrics and stock.valuation_metrics.current_price %}
        <tr><td>Price</td><td>${{ "%.2f"|format(stock.valuation_metrics.current_price) }}</td></tr>
        {% endif %}
        {% if stock.price_targets and stock.price_targets.base_target %}
        <tr><td>Base target (12-mo)</td><td>${{ "%.2f"|format(stock.price_targets.base_target) }}</td></tr>
        {% endif %}
        {% if stock.valuation_metrics and stock.valuation_metrics.market_cap_millions %}
        <tr><td>Market cap</td><td>{% if stock.valuation_metrics.market_cap_millions >= 1000 %}${{ "%.1f"|format(stock.valuation_metrics.market_cap_millions / 1000) }}B{% else %}${{ "%.0f"|format(stock.valuation_metrics.market_cap_millions) }}M{% endif %}</td></tr>
        {% endif %}
        {% if stock.peer_comparison and stock.peer_comparison.sector %}
        <tr><td>Sector</td><td>{{ stock.peer_comparison.sector }}</td></tr>
        {% endif %}
        {% if stock.peer_comparison and stock.peer_comparison.industry %}
        <tr><td>Industry</td><td>{{ stock.peer_comparison.industry|clip(28) }}</td></tr>
        {% endif %}
    </table>

    <div class="bar"><b>DVRG Scores</b><span>0&ndash;10, normalized</span></div>
    <table class="kv">
        <tr><td>Business quality</td><td>{{ "%.1f"|format(stock.moat_score) }}{% if stock.quality_tier %} &middot; {{ stock.quality_tier }}{% endif %}</td></tr>
        {% if stock.valuation_axis is not none %}
        <tr><td>Valuation</td><td>{{ "%.1f"|format(stock.valuation_axis) }}{% if stock.valuation_tier %} &middot; {{ stock.valuation_tier }}{% endif %}</td></tr>
        {% endif %}
        {% if stock.moat_breakdown and stock.moat_breakdown.technical_strength %}
        <tr><td>Technical</td><td>{{ "%.1f"|format(stock.moat_breakdown.technical_strength) }}</td></tr>
        {% endif %}
        {% if stock.signal_breakdown %}
        <tr><td>Signal environment</td><td>{% if stock.signal_breakdown.has_divergence %}Divergent{% else %}Clean{% endif %}</td></tr>
        {% endif %}
        {% if stock.conviction_position and stock.conviction_position.conviction_level %}
        <tr><td>Conviction</td><td>{{ stock.conviction_position.conviction_level|capitalize }}</td></tr>
        {% endif %}
    </table>

    {% if stock.valuation_metrics %}
    <div class="bar"><b>Metrics</b><span>vs sector avg</span></div>
    <table class="cmp">
        <tr><th>Multiple</th><th>{{ stock.ticker }}</th><th>Sector</th></tr>
        {% if stock.valuation_metrics.pe_ratio %}
        <tr><td>P/E (TTM)</td><td class="us">{{ "%.1f"|format(stock.valuation_metrics.pe_ratio) }}</td><td>{% if stock.valuation_metrics.sector_avg_pe %}{{ "%.1f"|format(stock.valuation_metrics.sector_avg_pe) }}{% else %}&mdash;{% endif %}</td></tr>
        {% endif %}
        {% if stock.valuation_metrics.forward_pe %}
        <tr><td>Forward P/E</td><td class="us">{{ "%.1f"|format(stock.valuation_metrics.forward_pe) }}</td><td>&mdash;</td></tr>
        {% endif %}
        {% if stock.valuation_metrics.ps_ratio %}
        <tr><td>P/Sales</td><td class="us">{{ "%.2f"|format(stock.valuation_metrics.ps_ratio) }}</td><td>&mdash;</td></tr>
        {% endif %}
        {% if stock.valuation_metrics.pb_ratio %}
        <tr><td>Price/Book</td><td class="us">{{ "%.2f"|format(stock.valuation_metrics.pb_ratio) }}</td><td>&mdash;</td></tr>
        {% endif %}
        {% if stock.valuation_metrics.ev_ebitda %}
        <tr><td>EV/EBITDA</td><td class="us">{{ "%.1f"|format(stock.valuation_metrics.ev_ebitda) }}</td><td>{% if stock.valuation_metrics.sector_avg_ev_ebitda %}{{ "%.1f"|format(stock.valuation_metrics.sector_avg_ev_ebitda) }}{% else %}&mdash;{% endif %}</td></tr>
        {% endif %}
        {% if stock.valuation_metrics.peg_ratio %}
        <tr><td>PEG</td><td class="us">{{ "%.2f"|format(stock.valuation_metrics.peg_ratio) }}</td><td>&mdash;</td></tr>
        {% endif %}
        {% if stock.price_targets and stock.price_targets.base_target and stock.valuation_metrics.current_price and stock.valuation_metrics.current_price > 0 %}
        <tr class="grp"><td colspan="3">Targets</td></tr>
        <tr><td>Base upside</td><td class="us">{{ "%+.1f"|format((stock.price_targets.base_target / stock.valuation_metrics.current_price - 1) * 100) }}%</td><td>&mdash;</td></tr>
        {% if stock.price_targets.bull_target %}
        <tr><td>Bull / Bear</td><td class="us" colspan="2">${{ "%.2f"|format(stock.price_targets.bull_target) }} / ${{ "%.2f"|format(stock.price_targets.bear_target) }}</td></tr>
        {% endif %}
        {% endif %}
    </table>
    {% endif %}

</td>
</tr></table>

<div class="pfoot">&copy; {{ report.analysis_date[:4] }} DVRG &mdash; AI-generated probabilistic research. Not investment advice. Full disclosures on final page.</div>

{# ── Signal state and the reader's decision — flows directly after the
     front matter so an overflowing chart column never strands a half page ── #}
<div class="note-flow">
{# SIGNAL DIVERGENCE HERO #}
{% if stock.signal_breakdown and stock.signal_breakdown.has_divergence %}
<div class="divergence-alert{% if stock.fund_tech_divergence and stock.fund_tech_divergence.severity == 'MODERATE' %} moderate{% endif %}">
    <p class="alert-title">&#9888; SIGNAL DIVERGENCE DETECTED{% if stock.fund_tech_divergence %} ({{ stock.fund_tech_divergence.severity }}){% endif %}</p>
    <p>{{ stock.signal_breakdown.divergence_explanation }}</p>
    <p><strong>Recommendation:</strong> {{ stock.signal_breakdown.divergence_recommendation }}</p>
    {% if stock.fund_tech_divergence and stock.fund_tech_divergence.resolution_bias %}
    <p><em>Resolution bias: {{ stock.fund_tech_divergence.resolution_bias }}</em></p>
    {% endif %}
</div>
{% elif stock.signal_breakdown %}
<div class="all-clear">
    {% if 'neutral' in (stock.signal_breakdown.direction_consensus or '')|lower %}
    <p class="alert-title">&#10003; Signals Consistent &mdash; No Directional Edge</p>
    <p>Sources agree with each other but none is strong enough to carry the trade &mdash; consistent with the staged, patient entries recommended below.</p>
    {% else %}
    <p class="alert-title">&#10003; {{ stock.signal_breakdown.alignment_status|replace('✅', '')|replace('⚠️', '')|trim }}</p>
    <p>{{ stock.signal_breakdown.direction_consensus|capitalize }}</p>
    {% endif %}
</div>
{% else %}
<div class="all-clear">
    <p class="alert-title">Signal Analysis Unavailable</p>
    <p>Multi-source signal data not available for this analysis.</p>
</div>
{% endif %}

{# QUICK ACTION SUMMARY — Current Holders vs New Buyers #}
{% if stock.decision_framework %}
<div class="action-summary">
    <div class="action-col">
        <p class="action-header">Current Holders</p>
        <p class="action-text">
            <strong>{{ stock.decision_framework.current_holders.action }}</strong> —
            {{ stock.decision_framework.current_holders.detail|clip(100) }}
        </p>
    </div>
    <div class="action-col">
        <p class="action-header">New Buyers</p>
        <p class="action-text">
            <strong>{{ stock.decision_framework.new_buyers.action }}</strong> —
            {{ stock.decision_framework.new_buyers.detail|clip(100) }}
        </p>
    </div>
</div>
{% endif %}

{# WHAT'S WORKING vs WHAT'S CONCERNING #}
<div class="two-col">
    <div class="col col-working">
        <p class="col-header">What's Working</p>
        {% if stock.key_insights %}
        <ul class="compact-list">
        {% for insight in stock.key_insights[:3] %}
            {% set words = insight.split() %}
            <li>{% if words|length > 28 %}{{ words[:28]|join(' ') }}...{% else %}{{ insight }}{% endif %}</li>
        {% endfor %}
        </ul>
        {% else %}
        <ul class="compact-list"><li><em>No insights available</em></li></ul>
        {% endif %}
    </div>
    <div class="col col-concerning">
        <p class="col-header">What's Concerning</p>
        {% if stock.structured_risks %}
        <ul class="compact-list">
        {% for risk in stock.structured_risks[:3] %}
            <li><strong>{{ risk.severity }}:</strong> {{ risk.risk|clip(80) }}</li>
        {% endfor %}
        </ul>
        {% elif stock.risk_factors %}
        <ul class="compact-list">
        {% for risk in stock.risk_factors[:3] %}
            {% set words = risk.split() %}
            <li>{% if words|length > 28 %}{{ words[:28]|join(' ') }}...{% else %}{{ risk }}{% endif %}</li>
        {% endfor %}
        </ul>
        {% else %}
        <ul class="compact-list"><li><em>No risk factors available</em></li></ul>
        {% endif %}
    </div>
</div>

{# ── WHY — VALUATION & PRICE TARGETS ─── #}
{% if stock.valuation_metrics or stock.price_targets %}
<h2 class="section-header">Valuation &amp; Price Targets <span class="hdr-note">— Why</span></h2>

{% if stock.valuation_metrics %}
<h3 class="section-subheader">Valuation Multiples</h3>
<p style="font-size: 8pt;"><strong>Category:</strong> {{ stock.valuation_metrics.valuation_category or "N/A" }}</p>

<table class="data-table">
    <thead>
        <tr><th>Multiple</th><th style="text-align: right;">Value</th><th style="text-align: right;">Sector Avg</th></tr>
    </thead>
    <tbody>
        {% if stock.valuation_metrics.pe_ratio %}<tr><td>P/E (TTM)</td><td class="num">{{ "%.1f"|format(stock.valuation_metrics.pe_ratio) }}x</td><td class="num">{% if stock.valuation_metrics.sector_avg_pe %}{{ "%.1f"|format(stock.valuation_metrics.sector_avg_pe) }}x{% else %}—{% endif %}</td></tr>{% endif %}
        {% if stock.valuation_metrics.forward_pe %}<tr><td>Forward P/E</td><td class="num">{{ "%.1f"|format(stock.valuation_metrics.forward_pe) }}x</td><td class="num">—</td></tr>{% endif %}
        {% if stock.valuation_metrics.peg_ratio %}<tr><td>PEG Ratio</td><td class="num">{{ "%.2f"|format(stock.valuation_metrics.peg_ratio) }}</td><td class="num">—</td></tr>{% endif %}
        {% if stock.valuation_metrics.pb_ratio %}<tr><td>P/B Ratio</td><td class="num">{{ "%.2f"|format(stock.valuation_metrics.pb_ratio) }}x</td><td class="num">—</td></tr>{% endif %}
        {% if stock.valuation_metrics.ps_ratio %}<tr><td>P/S Ratio</td><td class="num">{{ "%.2f"|format(stock.valuation_metrics.ps_ratio) }}x</td><td class="num">—</td></tr>{% endif %}
        {% if stock.valuation_metrics.ev_ebitda %}<tr><td>EV/EBITDA</td><td class="num">{{ "%.1f"|format(stock.valuation_metrics.ev_ebitda) }}x</td><td class="num">{% if stock.valuation_metrics.sector_avg_ev_ebitda %}{{ "%.1f"|format(stock.valuation_metrics.sector_avg_ev_ebitda) }}x{% else %}—{% endif %}</td></tr>{% endif %}
    </tbody>
</table>

{% if stock.valuation_metrics.dividend_yield %}
<p style="font-size: 8pt; margin-top: 6pt;">
    <strong>Dividend:</strong> {{ "%.2f"|format(stock.valuation_metrics.dividend_yield) }}% yield
    &middot; {{ "%.1f"|format(stock.valuation_metrics.payout_ratio) }}% payout
</p>
{% endif %}
{% endif %}

{% if stock.price_targets %}
<h3 class="section-subheader">Price Target Scenarios (12-Month)</h3>
<p style="font-size: 7.5pt; color: #718096;"><strong>Methodology:</strong> {{ stock.price_targets.methodology }}</p>

<table class="data-table">
    <thead>
        <tr><th>Scenario</th><th style="text-align: right;">Target</th><th style="text-align: right;">Probability</th><th>Key Assumptions</th></tr>
    </thead>
    <tbody>
        <tr>
            <td class="strong text-success">Re-rating Scenario</td>
            <td class="num">${{ "%.2f"|format(stock.price_targets.bull_target) }}</td>
            <td class="num">{{ "%.0f"|format(stock.price_targets.bull_probability * 100) }}%</td>
            <td style="font-size: 7.2pt;">{{ stock.price_targets.bull_assumptions|clip(150) }}</td>
        </tr>
        <tr>
            <td class="strong">Continuation Scenario</td>
            <td class="num">${{ "%.2f"|format(stock.price_targets.base_target) }}</td>
