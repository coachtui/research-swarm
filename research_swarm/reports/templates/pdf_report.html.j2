<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DVRG — AI Stock Analysis Report — {{ report.run_name or report.run_id }}</title>
</head>
<body>

{# ═══════════════════════════════════════════════════════════════════════════
   TITLE PAGE
   ═══════════════════════════════════════════════════════════════════════════ #}
<div class="cover-header" style="padding-top: 0.5in; margin-bottom: 0.3in;">
    <p class="brand">DVRG</p>
    <p class="subtitle">AI Stock Analysis Report</p>
</div>

<div class="cover-meta">
    <div>
        <div style="font-size: 16pt; font-weight: 700; color: #1a1a2e;">
            {{ report.run_name or ("Run " ~ report.run_id[:8]) }}
        </div>
        <div style="font-size: 9pt; color: #718096; margin-top: 4pt;">
            Run ID: {{ report.run_id }}
        </div>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 10pt; color: #718096;">
            Generated {{ report.generated_at.strftime('%B %d, %Y') }}
        </div>
        <div style="font-size: 10pt; color: #718096; margin-top: 2pt;">
            Analysis Period: {{ report.analysis_period }}
        </div>
    </div>
</div>

<div class="metrics-row" style="margin: 0.35in 0;">
    <div class="metric-item">
        <p class="metric-label">Stocks Analyzed</p>
        <p class="metric-value">{{ report.completed_count }}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Average Score</p>
        <p class="metric-value">{{ "%.1f"|format(report.average_moat_score) }}/10</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Top Picks</p>
        <p class="metric-value">{{ report.top_picks|length }}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Watchlist</p>
        <p class="metric-value">{{ report.watchlist_candidates|length }}</p>
    </div>
    {% if report.failed_count > 0 %}
    <div class="metric-item">
        <p class="metric-label">Failed</p>
        <p class="metric-value" style="color: #EF4444;">{{ report.failed_count }}</p>
    </div>
    {% endif %}
</div>

{# Table of Contents #}
<h2 class="section-header">Table of Contents</h2>
<table class="data-table">
    <thead>
        <tr>
            <th>Ticker</th>
            <th>Rating</th>
            <th style="text-align: right;">Score</th>
            <th>Risk</th>
            <th>Cohort</th>
        </tr>
    </thead>
    <tbody>
        {% set top_tickers = report.top_picks | map(attribute='ticker') | list %}
        {% set watchlist_tickers = report.watchlist_candidates | map(attribute='ticker') | list %}
        {% for stock in stocks %}
        <tr>
            <td class="strong">{{ stock.ticker }}</td>
            <td>
                {% if stock.rating %}
                <span class="badge badge-{{ stock.rating|lower|replace(' ', '-') }}">{{ stock.rating }}</span>
                {% else %}—{% endif %}
            </td>
            <td class="num">{{ "%.1f"|format(stock.moat_score) }}/10</td>
            <td>{{ stock.risk_level or "—" }}</td>
            <td>
                {% if stock.ticker in top_tickers %}Top Pick
                {% elif stock.ticker in watchlist_tickers %}Watchlist
                {% else %}Reviewed{% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div class="disclaimer" style="margin-top: 0.4in;">
    This report contains AI-generated probabilistic estimates and does not constitute
    investment advice or a solicitation to buy or sell any security. All price targets and
    scenarios are forward-looking and subject to material change. Past performance is not
    indicative of future results. Consult a qualified financial advisor before acting on
    any information in this report. © DVRG — AI-Powered Institutional-Grade Stock Analysis.
</div>

{# ═══════════════════════════════════════════════════════════════════════════
   PER-STOCK PAGES
   ═══════════════════════════════════════════════════════════════════════════ #}
{% for stock in stocks %}
<div class="page-break"></div>

{# ── PAGE 1 of each stock: THE CALL ───────────────────────────────────────── #}

<div class="cover-header">
    <p class="brand" data-ticker="{{ stock.ticker }}">DVRG</p>
    <p class="subtitle">AI-Powered Stock Intelligence</p>
</div>

<div class="cover-meta">
    <span class="ticker">{{ stock.ticker }}</span>
    <span class="date">{{ report.analysis_date }} &middot; {{ report.analysis_period }}</span>
</div>

{# VERDICT BOX #}
{% if stock.decision_framework %}
<div class="verdict-box">
    <h2 class="verdict-header">The Verdict</h2>
    <p class="verdict-summary">{{ stock.decision_framework.one_liner }}</p>
    {% if stock.conviction_statement %}
    <p class="verdict-detail">
        {{ stock.conviction_statement.bottom_line[:220] }}{% if stock.conviction_statement.bottom_line|length > 220 %}...{% endif %}
    </p>
    {% elif stock.investment_thesis and stock.investment_thesis is not string %}
    <p class="verdict-detail">{{ stock.investment_thesis.recommendation_summary }}</p>
    {% endif %}
</div>
{% elif stock.investment_thesis %}
<div class="verdict-box">
    <h2 class="verdict-header">The Verdict</h2>
    {% if stock.investment_thesis is string %}
    <p class="verdict-summary">
        {{ stock.investment_thesis[:200] }}{% if stock.investment_thesis|length > 200 %}...{% endif %}
    </p>
    {% else %}
    <p class="verdict-summary">{{ stock.investment_thesis.recommendation_summary }}</p>
    {% endif %}
</div>
{% endif %}

{# SIGNAL DIVERGENCE HERO #}
{% if stock.signal_breakdown and stock.signal_breakdown.has_divergence %}
<div class="divergence-alert{% if stock.fund_tech_divergence and stock.fund_tech_divergence.severity == 'MODERATE' %} moderate{% endif %}">
    <p class="alert-title">&#9888; SIGNAL DIVERGENCE DETECTED{% if stock.fund_tech_divergence %} ({{ stock.fund_tech_divergence.severity }}){% endif %}</p>
    <p>{{ stock.signal_breakdown.divergence_explanation }}</p>
    <p><strong>Recommendation:</strong> {{ stock.signal_breakdown.divergence_recommendation }}</p>
    {% if stock.fund_tech_divergence and stock.fund_tech_divergence.resolution_bias %}
    <p><em>Resolution bias: {{ stock.fund_tech_divergence.resolution_bias }}</em></p>
    {% endif %}
</div>
{% elif stock.signal_breakdown %}
<div class="all-clear">
    <p class="alert-title">&#10003; Signals Aligned — {{ stock.signal_breakdown.alignment_status }}</p>
    <p>{{ stock.signal_breakdown.direction_consensus|capitalize }}</p>
</div>
{% else %}
<div class="all-clear">
    <p class="alert-title">Signal Analysis Unavailable</p>
    <p>Multi-source signal data not available for this analysis.</p>
</div>
{% endif %}

{# THE CALL BOX #}
<div class="the-call-box">
    <div class="call-header">
        <span class="call-label">The Call</span>
        {% if stock.rating %}
        <span class="badge badge-{{ stock.rating|lower|replace(' ', '-') }}">{{ stock.rating }}</span>
        {% endif %}
        {% if stock.risk_level %}
        <span class="badge badge-{{ stock.risk_level|lower }}">{{ stock.risk_level }} Risk</span>
        {% endif %}
    </div>
    {% if stock.decision_framework %}
    <p class="one-liner">{{ stock.decision_framework.one_liner }}</p>
    {% elif stock.investment_thesis %}
    <p class="one-liner">
        {% if stock.investment_thesis is string %}
        {{ stock.investment_thesis[:160] }}{% if stock.investment_thesis|length > 160 %}...{% endif %}
        {% else %}
        {{ stock.investment_thesis.recommendation_summary }}
        {% endif %}
    </p>
    {% endif %}
</div>

{# SCORE DISPLAY #}
<div class="score-display">
    <div>
        <span class="score-big {% if stock.moat_score >= 8.5 %}score-strong-buy{% elif stock.moat_score >= 7.0 %}score-buy{% elif stock.moat_score >= 5.0 %}score-hold{% elif stock.moat_score >= 3.0 %}score-sell{% else %}score-strong-sell{% endif %}">{{ "%.1f"|format(stock.moat_score) }}</span>
        <span class="score-label">/10</span>
    </div>
    <div>
        <div class="score-band">
            {% if stock.moat_score >= 8.5 %}<span class="active">8.5+ Strong Buy</span>{% else %}8.5+ Strong Buy{% endif %} &middot;
            {% if stock.moat_score >= 7.0 and stock.moat_score < 8.5 %}<span class="active">7.0–8.4 Buy</span>{% else %}7.0–8.4 Buy{% endif %} &middot;
            {% if stock.moat_score >= 5.0 and stock.moat_score < 7.0 %}<span class="active">5.0–6.9 Hold</span>{% else %}5.0–6.9 Hold{% endif %} &middot;
            {% if stock.moat_score >= 3.0 and stock.moat_score < 5.0 %}<span class="active">3.0–4.9 Sell</span>{% else %}3.0–4.9 Sell{% endif %} &middot;
            {% if stock.moat_score < 3.0 %}<span class="active">&lt;3.0 Strong Sell</span>{% else %}&lt;3.0 Strong Sell{% endif %}
        </div>
    </div>
</div>

{# QUICK ACTION SUMMARY — Current Holders vs New Buyers #}
{% if stock.decision_framework %}
<div class="action-summary">
    <div class="action-col">
        <p class="action-header">Current Holders</p>
        <p class="action-text">
            <strong>{{ stock.decision_framework.current_holders.action }}</strong> —
            {{ stock.decision_framework.current_holders.detail[:100] }}{% if stock.decision_framework.current_holders.detail|length > 100 %}...{% endif %}
        </p>
    </div>
    <div class="action-col">
        <p class="action-header">New Buyers</p>
        <p class="action-text">
            <strong>{{ stock.decision_framework.new_buyers.action }}</strong> —
            {{ stock.decision_framework.new_buyers.detail[:100] }}{% if stock.decision_framework.new_buyers.detail|length > 100 %}...{% endif %}
        </p>
    </div>
</div>
{% endif %}

{# WHAT'S WORKING vs WHAT'S CONCERNING #}
<div class="two-col">
    <div class="col col-working">
        <p class="col-header">What's Working</p>
        {% if stock.key_insights %}
        <ul class="compact-list">
        {% for insight in stock.key_insights[:3] %}
            {% set words = insight.split() %}
            <li>{% if words|length > 28 %}{{ words[:28]|join(' ') }}...{% else %}{{ insight }}{% endif %}</li>
        {% endfor %}
        </ul>
        {% else %}
        <ul class="compact-list"><li><em>No insights available</em></li></ul>
        {% endif %}
    </div>
    <div class="col col-concerning">
        <p class="col-header">What's Concerning</p>
        {% if stock.structured_risks %}
        <ul class="compact-list">
        {% for risk in stock.structured_risks[:3] %}
            <li><strong>{{ risk.severity }}:</strong> {{ risk.risk[:80] }}{% if risk.risk|length > 80 %}...{% endif %}</li>
        {% endfor %}
        </ul>
        {% elif stock.risk_factors %}
        <ul class="compact-list">
        {% for risk in stock.risk_factors[:3] %}
            {% set words = risk.split() %}
            <li>{% if words|length > 28 %}{{ words[:28]|join(' ') }}...{% else %}{{ risk }}{% endif %}</li>
        {% endfor %}
        </ul>
        {% else %}
        <ul class="compact-list"><li><em>No risk factors available</em></li></ul>
        {% endif %}
    </div>
</div>

{# KEY METRICS ROW #}
<div class="metrics-row">
    <div class="metric-item">
        <p class="metric-label">Current Price</p>
        <p class="metric-value">{% if stock.valuation_metrics and stock.valuation_metrics.current_price %}${{ "%.2f"|format(stock.valuation_metrics.current_price) }}{% else %}N/A{% endif %}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Base Target</p>
        <p class="metric-value">{% if stock.price_targets %}${{ "%.2f"|format(stock.price_targets.base_target) }}{% else %}N/A{% endif %}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Upside</p>
        <p class="metric-value {% if stock.price_targets and stock.valuation_metrics and stock.valuation_metrics.current_price and stock.valuation_metrics.current_price > 0 %}{% if (stock.price_targets.base_target / stock.valuation_metrics.current_price - 1) * 100 > 0 %}text-success{% else %}text-error{% endif %}{% endif %}">
            {% if stock.price_targets and stock.valuation_metrics and stock.valuation_metrics.current_price and stock.valuation_metrics.current_price > 0 %}
            {{ "%+.1f"|format((stock.price_targets.base_target / stock.valuation_metrics.current_price - 1) * 100) }}%
            {% else %}N/A{% endif %}
        </p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Risk Level</p>
        <p class="metric-value">{{ stock.risk_level or "N/A" }}</p>
    </div>
    <div class="metric-item">
        <p class="metric-label">Overall Score</p>
        <p class="metric-value">{{ "%.1f"|format(stock.moat_score) }}/10</p>
    </div>
</div>

{# ── PAGE 2: SIGNAL DEEP DIVE ─────────────────────────────────────────────── #}
{% if stock.signal_breakdown %}
<div class="page-break"></div>
<h2 class="section-header">Signal Deep Dive</h2>
<p style="font-size: 10pt; color: #4a5568;">Multi-source signal analysis with divergence detection. Each signal scored 0–10.</p>

{% set signals = [
    ("News Sentiment",       stock.signal_breakdown.news_score,          stock.signal_breakdown.news_interpretation),
    ("Earnings Revisions",   stock.signal_breakdown.earnings_score,       stock.signal_breakdown.earnings_interpretation),
    ("Analyst Ratings",      stock.signal_breakdown.analyst_score,        stock.signal_breakdown.analyst_interpretation),
    ("Institutional",        stock.signal_breakdown.institutional_score,  stock.signal_breakdown.institutional_interpretation),
    ("Insider Activity",     stock.signal_breakdown.insider_score,        stock.signal_breakdown.insider_interpretation)
] %}

{% for name, score, interp in signals %}
<div class="signal-row">
    <span class="signal-label">{{ name }}</span>
    <div class="signal-bar-bg">
        <div class="signal-bar-fill {% if score >= 7.0 %}bar-strong{% elif score >= 4.0 %}bar-moderate{% else %}bar-weak{% endif %}" style="width: {{ (score / 10 * 100)|int }}%;"></div>
    </div>
    <span class="signal-score {% if score >= 7.0 %}text-success{% elif score >= 4.0 %}text-warning{% else %}text-error{% endif %}">{{ "%.1f"|format(score) }}</span>
    <span style="font-size: 8.5pt; color: #718096; width: 90pt;">{{ interp }}</span>
</div>
{% endfor %}

<div style="margin-top: 8pt;">
    <p style="font-size: 10pt;"><strong>Overall Sentiment:</strong> {{ "%.1f"|format(stock.signal_breakdown.overall_score) }}/10</p>
    <p style="font-size: 10pt;"><strong>Signal Alignment:</strong> {{ stock.signal_breakdown.alignment_status }}</p>
    <p style="font-size: 10pt;"><strong>Direction Consensus:</strong> {{ stock.signal_breakdown.direction_consensus|capitalize }}</p>
</div>

{# SCORE BREAKDOWN TABLE #}
<h3 class="section-subheader" style="margin-top: 16pt;">Score Breakdown</h3>
<table class="data-table">
    <thead>
        <tr><th>Component</th><th style="text-align: right;">Weight</th><th style="text-align: right;">Score</th></tr>
    </thead>
    <tbody>
        <tr><td class="strong">Earnings Momentum &#11088;</td><td class="num">25%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.earnings_momentum if stock.moat_breakdown.earnings_momentum is not none else 0.0) }}/10</td></tr>
        <tr><td>Financial Health</td><td class="num">25%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.financial_health if stock.moat_breakdown.financial_health is not none else 0.0) }}/10</td></tr>
        <tr><td>Valuation</td><td class="num">20%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.valuation if stock.moat_breakdown.valuation is not none else 0.0) }}/10</td></tr>
        <tr><td>Technical/Momentum</td><td class="num">15%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.technical_strength if stock.moat_breakdown.technical_strength is not none else 0.0) }}/10</td></tr>
        <tr><td>Sentiment/Catalysts</td><td class="num">15%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.sentiment_catalysts if stock.moat_breakdown.sentiment_catalysts is not none else 0.0) }}/10</td></tr>
        <tr><td class="strong">Overall Score</td><td class="num"></td><td class="num strong">{{ "%.1f"|format(stock.moat_score) }}/10</td></tr>
    </tbody>
</table>
<p style="font-size: 8pt; color: #718096;">&#11088; Earnings Momentum is the PRIMARY signal (consensus estimate revisions).</p>
{% endif %}

{# ── SIGNAL METRICS — Investor+ ────────────────────────────────────────────
   EV stability class (σ band), noise regime + score, stop probability
   headline, and stop probability decomposition table.
   Hidden for Starter tier. ──────────────────────────────────────────────── #}
{% if include_signal_metrics and stock.signal_breakdown %}
<div class="page-break"></div>
<h2 class="section-header">Signal Metrics <span style="font-size: 9pt; font-weight: 400; color: #718096;">— Probabilistic Engine</span></h2>
<p style="font-size: 9pt; color: #718096; margin-bottom: 10pt;">EV stability, noise environment, and stop probability headline derived from the probabilistic engine.</p>

<div class="metrics-row" style="margin-bottom: 12pt;">
{% if stock.signal_breakdown.ev_stability %}
    <div class="metric-item">
        <p class="metric-label">EV Stability</p>
        <p class="metric-value" style="font-size: 11pt;">{{ stock.signal_breakdown.ev_stability.stability_class }}</p>
        <p class="metric-label">σ Band ±{{ "%.1f"|format(stock.signal_breakdown.ev_stability.ev_sensitivity_band_pct) }}%</p>
    </div>
{% endif %}
{% if stock.signal_breakdown.noise_filter %}
    <div class="metric-item">
        <p class="metric-label">Noise Regime</p>
        <p class="metric-value" style="font-size: 11pt;">{{ stock.signal_breakdown.noise_filter.noise_regime }}</p>
        <p class="metric-label">Score {{ "%.1f"|format(stock.signal_breakdown.noise_filter.noise_score) }}/10</p>
    </div>
{% endif %}
{% if stock.signal_breakdown.stop_probability %}
    <div class="metric-item">
        <p class="metric-label">Stop Probability</p>
        <p class="metric-value" style="font-size: 11pt;">{{ "%.1f"|format(stock.signal_breakdown.stop_probability.effective_stop_probability_pct) }}%</p>
        <p class="metric-label">{{ stock.signal_breakdown.stop_probability.stop_probability_label }}</p>
    </div>
{% endif %}
{% if stock.signal_breakdown.confidence_integrity %}
    <div class="metric-item">
        <p class="metric-label">EV Confidence</p>
        <p class="metric-value" style="font-size: 11pt;">{{ "%.0f"|format(stock.signal_breakdown.confidence_integrity.effective_confidence_pct) }}%</p>
        <p class="metric-label">{{ stock.signal_breakdown.confidence_integrity.ev_confidence_level }}</p>
    </div>
{% endif %}
</div>

{# Stop probability decomposition table #}
{% if stock.signal_breakdown.stop_probability %}
<h3 class="section-subheader">Stop Probability Decomposition</h3>
<table class="data-table">
    <thead><tr><th>Component</th><th style="text-align: right;">Value</th></tr></thead>
    <tbody>
        <tr><td>Base Stop Risk</td><td class="num">{{ "%.1f"|format(stock.signal_breakdown.stop_probability.base_stop_risk_pct) }}%</td></tr>
        <tr><td>Volatility Pressure</td><td class="num">+{{ "%.1f"|format(stock.signal_breakdown.stop_probability.volatility_pressure_pct) }}%</td></tr>
        <tr><td>Trend Modifier</td><td class="num">{{ "%+.1f"|format(stock.signal_breakdown.stop_probability.trend_modifier_pct) }}%</td></tr>
        <tr><td>Support Modifier</td><td class="num">{{ "%+.1f"|format(stock.signal_breakdown.stop_probability.support_modifier_pct) }}%</td></tr>
        <tr><td class="strong"><strong>Effective Stop Probability</strong></td><td class="num strong">{{ "%.1f"|format(stock.signal_breakdown.stop_probability.effective_stop_probability_pct) }}%</td></tr>
    </tbody>
</table>
{% if stock.signal_breakdown.stop_probability.decomposition_narrative %}
<p style="font-size: 9pt; color: #4a5568; margin-top: 6pt;">{{ stock.signal_breakdown.stop_probability.decomposition_narrative }}</p>
{% endif %}
{% endif %}
{% endif %}

{# ── PAGE 3: INVESTMENT THESIS & COMPETITIVE ADVANTAGE ───────────────────── #}
<div class="page-break"></div>
<h2 class="section-header">Investment Thesis</h2>

{% if stock.investment_thesis and stock.investment_thesis is not string %}
{# ── Structured InvestmentThesisStructured (v2 — normal case) ── #}

<div class="thesis-block">
    <p style="margin: 0 0 6pt 0;"><strong>Overview:</strong> {{ stock.investment_thesis.company_overview }}</p>
    <p style="margin: 0;"><strong>Recommendation:</strong> {{ stock.investment_thesis.recommendation_summary }}</p>
</div>

{% if stock.investment_thesis.investment_highlights %}
<h3 class="section-subheader">Investment Highlights</h3>
<ul class="compact-list" style="font-size: 10pt;">
    {% for highlight in stock.investment_thesis.investment_highlights %}
    <li>{{ highlight }}</li>
    {% endfor %}
</ul>
{% endif %}

<h3 class="section-subheader">Valuation &amp; Signal Analysis</h3>
<p style="font-size: 10pt; line-height: 1.6; color: #4a5568;">{{ stock.investment_thesis.valuation_signal_analysis }}</p>

<h3 class="section-subheader">Key Risks</h3>
<ul class="compact-list" style="font-size: 10pt;">
    {% for risk in stock.investment_thesis.key_risks %}
    <li>{{ risk }}</li>
    {% endfor %}
</ul>

<h3 class="section-subheader">Entry Strategy &amp; Investor Fit</h3>
<p style="font-size: 10pt; line-height: 1.6; color: #4a5568;">{{ stock.investment_thesis.entry_strategy }}</p>

{% elif stock.investment_thesis %}
{# ── Legacy string fallback ── #}
<div class="thesis-block">
    {% set words = stock.investment_thesis.split() %}
    {% if words|length > 150 %}{{ words[:150]|join(' ') }}...{% else %}{{ stock.investment_thesis }}{% endif %}
</div>
{% else %}
<div class="thesis-block" style="color: #718096; font-style: italic;">
    No investment thesis available for this analysis.
</div>
{% endif %}

{% if stock.enhanced_moat %}
<h3 class="section-subheader">Competitive Advantage Analysis</h3>
<p style="font-size: 10pt;">
    <strong>Advantage Strength:</strong> {{ stock.enhanced_moat.moat_width }}
    &middot; <strong>Sustainability:</strong> {{ stock.enhanced_moat.moat_durability }}
    &middot; <strong>Composite:</strong> {{ "%.1f"|format(stock.enhanced_moat.composite_score) }}/10
</p>

<table class="data-table">
    <thead>
        <tr><th>Category</th><th style="text-align: right;">Score</th><th>Assessment</th></tr>
    </thead>
    <tbody>
        {% for cat_key, cat_label, strong_label, mod_label, weak_label in [
            ('network_effects',         'Network Effects',   'Strong',      'Moderate',    'Weak'),
            ('switching_costs',         'Switching Costs',   'High',        'Moderate',    'Low'),
            ('brand_power',             'Brand Power',       'Premium',     'Recognized',  'Generic'),
            ('cost_advantages',         'Cost Advantages',   'Significant', 'Moderate',    'Minimal'),
            ('scale_economies',         'Scale Economies',   'Leader',      'Competitive', 'Disadvantaged'),
            ('intangible_assets',       'Intangible Assets', 'Strong IP',   'Some IP',     'Limited'),
            ('regulatory_barriers',     'Reg. Barriers',     'Protected',   'Some',        'Open'),
            ('distribution_advantages', 'Distribution',      'Dominant',    'Established', 'Limited'),
        ] %}
        {% set score = stock.enhanced_moat[cat_key] if stock.enhanced_moat[cat_key] is defined else 0 %}
