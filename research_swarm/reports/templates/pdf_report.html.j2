        <tr><td class="strong">Overall Score</td><td class="num strong">{{ "%.1f"|format(stock.moat_score) }}/10</td></tr>
    </tbody>
</table>
<p style="font-size: 7pt; color: #718096;">Report generated before the two-axis scoring model; component weighting reflects the methodology in effect at analysis time.</p>
