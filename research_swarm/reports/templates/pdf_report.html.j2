        {% else %}
        <tr><td>Financial Health</td><td class="num">55%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.financial_health or 0.0) }}/10</td></tr>
        <tr><td>Earnings Momentum</td><td class="num">45%</td><td class="num">{{ "%.1f"|format(stock.moat_breakdown.earnings_momentum or 0.0) }}/10</td></tr>
        {% endif %}
        <tr><td class="strong">Business Quality (normalized)</td><td class="num"></td><td class="num strong">{{ "%.1f"|format(stock.moat_score) }}/10</td></tr>
    </tbody>
</table>
<table class="data-table" style="margin-top: 8pt;">
    <tbody>
        <tr><td class="strong">Valuation Axis</td><td class="num strong">{{ "%.1f"|format(stock.valuation_axis) }}/10</td><td style="font-size: 7.2pt;">higher = more attractively priced &middot; {{ stock.valuation_tier }}</td></tr>
